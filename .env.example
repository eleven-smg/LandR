# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real keys.
#
# All Supabase values come from your project's Settings -> API page.

# Project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# Server only. This key bypasses row level security, which is what every
# server action and route handler in this project relies on. Never expose it
# to the browser and never copy it into a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shared basic-auth credentials protecting /dashboard, enforced in
# middleware.ts. Per-creator passwords live in creators.dashboard_password
# and are not wired up yet.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=choose_a_password
